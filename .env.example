SERVER_PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
# Legacy fallback is supported for existing local setups; use the two secrets above in production.
JWT_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
OTP_PROVIDER=console
DEV_OTP_BYPASS=false
AGORA_TOKEN_TTL_SECONDS=3600
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
